# Platform-provided persistent workspace.
COMPETITION_WORKSPACE=/2026aicompetition/workspace

# Obtain the complete value from the competition container page.
COMPETITION_CALLBACK_URL=http://platform/api/competition/inference/callback/

# Keep one worker until real models are proven safe for concurrent GPU use.
COMPETITION_MAX_WORKERS=1
COMPETITION_CALLBACK_TIMEOUT=10
COMPETITION_CALLBACK_ATTEMPTS=3

# Optional real-plugin entry point. Omit to run the format-correct Dummy baseline.
# COMPETITION_PIPELINE_FACTORY=tasks.real_pipeline:build_pipeline

# Trainable Goal3/4/5 PyTorch baseline. Set these after training and copying
# the checkpoints into the competition image or mounted workspace.
# COMPETITION_PIPELINE_FACTORY=tasks.torch_pipeline:build_pipeline
# Default locations used by tasks.torch_pipeline:
# /2026aicompetition/workspace/checkpoint/goal3.pt
# /2026aicompetition/workspace/checkpoint/goal4.pt
# /2026aicompetition/workspace/checkpoint/goal5.pt
# Optional explicit overrides:
# GOAL3_CHECKPOINT=/2026aicompetition/workspace/checkpoint/goal3.pt
# GOAL4_CHECKPOINT=/2026aicompetition/workspace/checkpoint/goal4.pt
# GOAL5_CHECKPOINT=/2026aicompetition/workspace/checkpoint/goal5.pt
